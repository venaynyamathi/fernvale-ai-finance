# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored, so your keys never get uploaded to GitHub.
# Use the DEVELOPMENT keys from developer.intuit.com -> demo-company -> Keys and credentials.

QBO_CLIENT_ID=paste-client-id-here
QBO_CLIENT_SECRET=paste-client-secret-here
QBO_REALM_ID=paste-sandbox-company-id-here
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:8765/callback
